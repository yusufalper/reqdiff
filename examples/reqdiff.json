{
  "left": {
    "url": "https://staging.example.com/users/me",
    "auth": {"type": "bearer", "token_env": "STAGING_TOKEN"}
  },
  "right": {
    "url": "https://api.example.com/users/me",
    "auth": {"type": "bearer", "token_env": "PROD_TOKEN"}
  },
  "compare": {
    "mode": "values",
    "ignore": ["/request_id"],
    "ignore_values": ["/updated_at", "/users/*/id"],
    "headers": ["Content-Type"],
    "max_latency_regression": "150ms"
  },
  "timeout": "10s",
  "max_body_bytes": 10485760,
  "format": "text"
}
